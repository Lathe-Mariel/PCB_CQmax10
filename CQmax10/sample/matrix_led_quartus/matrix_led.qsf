# =============================================================================
# matrix_led.qsf - Quartus Prime Lite project settings
#
# Device: MAX 10, 10M08SAE144C8G (144-pin EQFP)
#   -- This matches the "10M08SAE144C8G" part used on the CQ出版-style
#      MAX10 144-QFP boards (e.g. CQ-MAX10-A / PCB_CQmax10). If your actual
#      board uses a different MAX 10 density/speed grade or package, update
#      FAMILY / DEVICE below to match (Assignments > Device in the GUI).
# =============================================================================

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY top_matrix_led
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 2
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SDC_FILE matrix_led.sdc

# ------------------------------------------------------------------
# Source files
# ------------------------------------------------------------------
set_global_assignment -name SYSTEMVERILOG_FILE rtl/font_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/top_matrix_led.sv

# ------------------------------------------------------------------
# Pin assignments (from user-supplied physical constraint table)
# ------------------------------------------------------------------
set_location_assignment PIN_88 -to clk
set_location_assignment PIN_17 -to rst_n

set_location_assignment PIN_46 -to ROW
set_location_assignment PIN_45 -to COL_GREEN
set_location_assignment PIN_44 -to COL_RED

set_location_assignment PIN_43 -to CLR1
set_location_assignment PIN_41 -to CLR3
set_location_assignment PIN_39 -to CLR2

set_location_assignment PIN_38 -to RCLOCK
set_location_assignment PIN_47 -to CLOCK

# ------------------------------------------------------------------
# I/O standard: all signals are 3.3-V LVCMOS
# ------------------------------------------------------------------
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to ROW
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to COL_GREEN
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to COL_RED
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLR1
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLR3
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLR2
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to RCLOCK
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to CLOCK

# ------------------------------------------------------------------
# Unused pins: keep as inputs, tri-stated (adjust to your board's needs)
# ------------------------------------------------------------------
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_85 -to led
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led
set_location_assignment PIN_123 -to led0
set_location_assignment PIN_62 -to sw0
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to sw0
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led0
set_location_assignment PIN_59 -to leds[0]
set_location_assignment PIN_57 -to leds[1]
set_location_assignment PIN_55 -to leds[2]
set_location_assignment PIN_52 -to leds[3]
set_location_assignment PIN_60 -to leds[4]
set_location_assignment PIN_58 -to leds[5]
set_location_assignment PIN_56 -to leds[6]
set_location_assignment PIN_50 -to leds[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to leds
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top