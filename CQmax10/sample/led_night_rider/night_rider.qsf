# -------------------------------------------------------------------------- #
# Quartus Prime Settings File
# Device  : 10M08SCE144C8G (MAX 10)
# Board   : CQmax10 (https://github.com/Lathe-Mariel/PCB_CQmax10)
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY night_rider_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 23.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:04:00  AUGUST 25, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT NONE -section_id eda_simulation

# Source files
set_global_assignment -name SYSTEMVERILOG_FILE night_rider_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE night_rider.sv
set_global_assignment -name SYSTEMVERILOG_FILE pwm_controller.sv

# Pin assignments (3.3-V LVCMOS)
set_location_assignment PIN_88 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk

set_location_assignment PIN_17 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to rst_n

set_location_assignment PIN_59 -to led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[0]

set_location_assignment PIN_57 -to led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[1]

set_location_assignment PIN_55 -to led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[2]

set_location_assignment PIN_52 -to led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[3]

set_location_assignment PIN_60 -to led[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[4]

set_location_assignment PIN_58 -to led[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[5]

set_location_assignment PIN_56 -to led[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[6]

set_location_assignment PIN_50 -to led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led[7]

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name VERILOG_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name FLOW_ENABLE_POWER_ANALYZER ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "12.5 %"
set_location_assignment PIN_122 -to board_led[0]
set_location_assignment PIN_123 -to board_led[1]
set_location_assignment PIN_121 -to board_led[2]
set_location_assignment PIN_120 -to board_led[3]
set_location_assignment PIN_62 -to board_button[0]
set_location_assignment PIN_54 -to board_button[1]
set_location_assignment PIN_48 -to board_button[2]
set_location_assignment PIN_130 -to board_button[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_button[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_button[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_button[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_button[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_led
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to board_button
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top