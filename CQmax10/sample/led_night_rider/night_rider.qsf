# -------------------------------------------------------------------------- #
# Quartus Prime Settings File
# Device  : 10M08SCE144C8G (MAX 10)
# Board   : CQmax10 (https://github.com/Lathe-Mariel/PCB_CQmax10)
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY night_rider_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 23.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "21:04:00  AUGUST 25, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Intel FPGA (SystemVerilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation

# Source files
set_global_assignment -name SYSTEMVERILOG_FILE rtl/night_rider_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/night_rider.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pwm_controller.sv

# Pin assignments (3.3-V LVCMOS)
set_location_assignment PIN_88 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk

set_location_assignment PIN_17 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to rst_n

set_location_assignment PIN_98 -to "led[0]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[0]"

set_location_assignment PIN_101 -to "led[1]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[1]"

set_location_assignment PIN_99 -to "led[2]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[2]"

set_location_assignment PIN_100 -to "led[3]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[3]"

set_location_assignment PIN_96 -to "led[4]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[4]"

set_location_assignment PIN_105 -to "led[5]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[5]"

set_location_assignment PIN_97 -to "led[6]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[6]"

set_location_assignment PIN_106 -to "led[7]"
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to "led[7]"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
