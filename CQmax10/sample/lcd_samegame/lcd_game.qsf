# -------------------------------------------------------------------------- #
# lcd_game.qsf
# MAX 10 10M08SCE144C8G on the CQ-MAX10-A board + CQ-MAX10-A Pmod board
# PMOD-TFTLCD v1.1 (ILI9341, 320x240)
#
# Step 1 : fill the whole panel with one solid colour (orange).
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY samegame_top


# On-Chip Flash (UFM) IP — holds the logo pixels in user flash

set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "<None>"
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan

# ------------------------------------------------------------------ #
# Pin assignments (see prompt specification)
# ------------------------------------------------------------------ #
set_location_assignment PIN_88 -to clk
set_location_assignment PIN_17 -to btn_rst
set_location_assignment PIN_62 -to sw1
set_location_assignment PIN_48 -to sw2
set_location_assignment PIN_81 -to lcd_cs
set_location_assignment PIN_78 -to lcd_mosi
set_location_assignment PIN_75 -to lcd_sck
set_location_assignment PIN_77 -to lcd_dc

# ------------------------------------------------------------------ #
# INPUT DEVICE: Pmod-2xDS2 (Sipeed) - a PLAYSTATION 2 CONTROLLER PORT
# ------------------------------------------------------------------ #
# THE TOUCH PANEL IS GONE, and this note records why so it is not re-tried.
#
# The PMOD-TFTLCD's touch controller (XPT2046) was never made to work on this
# board.  MEASURED, exhaustively:
#   * every conversion returned 12'hFFF, i.e. MISO sat at a constant 1, and the
#     pad never went low anywhere in a whole 24-clock transfer;
#   * the SPI logic itself was proven correct - the bit-clock divider phase bug
#     that silently shortened the frame to 23 clocks was found and fixed, and a
#     structural testbench guard (exactly 24 rising edges per CS-low window) now
#     covers it;
#   * every PMOD socket's 7,8,9,10 row AND the J2/J4 low rows were probed, and
#     the module schematic was read to extract the pin netlist directly
#     (TP_SPI_CS=J3-1, MOSI=2, MISO=3, CLK=4).
# None of that ever produced a live pad, so the touch path cannot detect a press
# on this hardware.  The user decided to drop it.
#
# Pmod-2xDS2 is NOT a GPIO module - it is a PS2 pad port.  The pad is read over
# a SPI-like SYNCHRONOUS SERIAL bus (4 signals; "SEL" plays the role of chip
# select).  See ps2_controller.sv for the protocol, the 5-byte poll and the
# button bit map.
#
#   ps_sel : ATTENTION, active LOW, driven by this design (bus master)
#   ps_clk : bit clock, generated by this design
#   ps_cmd : master -> pad
#   ps_dat : pad -> master (the only INPUT of the four)
#
# ------------------------------------------------------------------ #
# Pmod-2xDS2 PIN ASSIGNMENTS - SUPPLIED BY THE USER.  Do not change these
# without re-confirming on the board; they are a MEASUREMENT, not a derivation.
#
#     CS   -> PIN_99   (ps_sel, active-low attention)
#     MOSI -> PIN_98   (ps_cmd, master -> pad)
#     MISO -> PIN_97   (ps_dat, pad -> master)
#     SCLK -> PIN_96   (ps_clk, generated here)
#
# Cross-check against CQmax10.kicad_pcb: socket J4's LOW row is pads 1..4 =
# 98, 99, 96, 97, so the four PS2 signals occupy that row - the same pattern the
# module uses (signals on the connector's pins 1..4).
#
# Bring-up check: led (PIN_85) LIT means the pad ANSWERED (0x5A signature), i.e.
# all four signals are in the right order.  DARK means nothing answered.
# ------------------------------------------------------------------ #
# These use socket J4's LOW row, as specified by the user - see the pin table
# below.  Do NOT re-derive these from a module schematic: a netlist can say which
# FPGA pin a socket pad reaches, but NOT which socket the module is plugged into
# or how the module orders its four signals.  That is a measurement.
# ------------------------------------------------------------------ #
# The trailing comments are deliberately on their OWN lines: a QSF `#` comment
# after a value on the same line is accepted by some Quartus versions and folded
# into the value by others, and a pin assignment is not worth that risk.
#
# ------------------------------------------------------------------ #
# BACK TO THE SUPPLIED TABLE - CMD/DAT ARE NOT SWAPPED.
#
# An earlier revision swapped pins 97 and 98, reasoning that the received reply
# byte 2 (measured as 0x00) matched THIS design's own command byte 2 and must
# therefore be a CMD->DAT loopback.
#
# That inference was NOT reliable: 0x00 is also what a data line stuck low reads,
# and the user's table is the authority.  Confirmation that the ORIGINAL order is
# right comes from the reference implementation this design is based on
# (Sipeed TangPrimer-25K nestang): its physical-constraints file names the four
# signals `joystick_cs`, `joystick_mosi`, `joystick_miso`, `joystick_clk` - the
# standard PMOD SPI order - which is exactly the order supplied:
#
#     CS (99) / MOSI (98) / MISO (97) / SCLK (96)
#
# So the assignment is the one the user gave, unchanged.
#
# The next build does NOT rely on inferring anything from a single LED any more:
# it DISPLAYS THE RECEIVED BYTE ITSELF four bits at a time (see samegame_top.sv),
# because reading the actual value is the only unambiguous way forward.  Look for
# the signature 0x5A - its two nibbles alternate as
#     low  nibble 0xA = lit,dark,lit,dark   and
#     high nibble 0x5 = dark,lit,dark,lit.
# ------------------------------------------------------------------ #
set_location_assignment PIN_99 -to ps_sel
set_location_assignment PIN_98 -to ps_cmd
set_location_assignment PIN_97 -to ps_dat
set_location_assignment PIN_96 -to ps_clk

set_location_assignment PIN_85 -to led
set_location_assignment PIN_122 -to led0
set_location_assignment PIN_123 -to led1
set_location_assignment PIN_120 -to led2
set_location_assignment PIN_121 -to led3

set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to btn_rst
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to sw1
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to sw2
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_cs
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_mosi
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_sck
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to lcd_dc
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to ps_sel
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to ps_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to ps_cmd
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to ps_dat

# ------------------------------------------------------------------ #
# WEAK PULL-UP ON ps_dat - this had gone MISSING and it is very likely part of
# why the pad never answered.
#
# MEASURED SYMPTOM: every bring-up LED stayed DARK, with only the odd flicker -
# i.e. the sampled data line read a steady 0 with occasional 1s.  That is exactly
# what a FLOATING input reads: with no pull-up and no active driver, the pin
# hovers near the middle of the rail and noise decides each sample.
#
# The PS2 data line must sit HIGH when nothing is driving it, so the weak pull-up
# is not optional here - it defines the idle level the protocol relies on.  A pad
# that answers pulls the line low for its zero bits.
#
# KEEP THIS LINE.  It is easy to lose when the surrounding comments are edited,
# and losing it looks exactly like a dead pad.
# ------------------------------------------------------------------ #
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to ps_dat
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led0
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led1
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led2
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to led3

# Buttons/switches are assumed to have external pull-ups on the board.
# Uncomment if yours do not:
#set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to btn_rst
#set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to sw1
#set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to sw2

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name SYSTEMVERILOG_FILE rtl/samegame_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/game_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/board_memory.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/floodfill_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/erase_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gravity_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/column_shift_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/score_manager.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/rng_generator.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ps2_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/logo_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ufm_bootloader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/lcd_renderer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/lcd_ili9341_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_byte_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/frame_seq.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/reset_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debounce.sv
set_global_assignment -name QIP_FILE logo_flash/synthesis/logo_flash.qip
set_global_assignment -name SDC_FILE lcd_game.sdc
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top